# The cache state lives in its OWN git + DVC repo under caches/ (separate from
# this code repo): the DVC pointers, manifests, .dvc store and the cached bytes
# all belong to that repo, never to the code history. Ignore the whole tree —
# including its nested .git/.dvc — so checkpoints can never touch code history.
/caches/

# Local environment files, whatever writes them. Never committed.
/.env
/.env.*

# Shuttle staging area (fixed export/import dirs) — local transfer artifacts.
/shuttle/
# Rewritten uv.locks produced by the lock-warm op — downloadable artifacts, not source.
/lockwarm/
*.bundle
/dvcstore/

# Disposable CoW snapshots and runtime state used by qualification scripts.
/.qualification/

# Bridge and debug logs written beside the code while testing by hand.
*.log

# Per-machine agent settings. The name says local; the rest of .claude/ is shared.
/.claude/settings.local.json

# Installer artefacts. Built from packaging/ by `make installers` and
# packaging/macos/build-pkg.sh, so they are outputs rather than sources — and a .pkg is
# ~15 MB of binary that git would keep a copy of for every rebuild.
packaging/**/*.pkg
packaging/**/*.deb

# What the removed Python stack's Docker builds left behind. Root-owned, so it takes
# `sudo rm -rf webui` to clear; ignored until then so it does not sit in every status.
/webui/

# Staged into the NSIS build and removed again; never committed.
packaging/windows/pkgcache.exe
packaging/windows/pkgcache-app.exe
packaging/windows/*-setup.exe
