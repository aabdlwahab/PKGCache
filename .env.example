# `scripts/bootstrap.sh` GENERATES .env (gitignored) from the live host — prefer it
# over copying this file by hand. This file documents what goes in it.
#
# Running the containers as the host user keeps everything they write under
# caches/ — the cache git+DVC repo, manifests, cached bytes — host-owned instead of
# root-owned, so the operator can manage them and the webui's git/dvc never leaves
# root-owned files.
#
#   PKGCACHE_UID=$(id -u)
#   PKGCACHE_GID=$(id -g)
#
# (Rootless Docker / Podman: container root already maps to you — set both to 0;
# bootstrap.sh detects this.)
PKGCACHE_UID=1000
PKGCACHE_GID=1000

# Host interfaces to publish. Keep 0.0.0.0 only on an isolated/trusted network;
# use 127.0.0.1 when a host reverse proxy or SSH tunnel is the public entry.
PKGCACHE_BIND=0.0.0.0
UI_BIND=127.0.0.1

# Break-glass superuser for the console. SETTING THESE TURNS ON control-plane auth
# (login + account/ownership enforcement); leave them unset to keep the API open on
# a trusted network. bootstrap.sh generates them with a random password by default
# (pass --no-auth to skip). Verified from the environment on every login, never
# written to the users store, and can't be demoted or deleted — the always-present
# root that bootstraps the first accounts. Use a strong, unique password (not the
# username).
# UI_ROOT_USER=admin
# UI_ROOT_PASSWORD=change-me-to-something-long

# When a reverse proxy terminates HTTPS in front of the console, set the exact
# browser-facing origin. This keeps the CSRF origin check correct across the
# HTTPS→HTTP internal hop and marks session cookies Secure automatically.
# UI_PUBLIC_ORIGIN=https://packages.example.com
# UI_COOKIE_SECURE=1
# UI_SESSION_TTL=43200
# UI_MAX_JSON_MB=64
# Trust X-Forwarded-For/Proto from the fronting proxy (on by default; the shipped
# console overwrites X-Forwarded-For with the real peer). Set to 0 only if webui is
# reachable WITHOUT such a proxy — otherwise a client could spoof its login-throttle
# key via the header.
# UI_TRUST_PROXY=1

# Anonymous read-only console. With auth on, set this to let a caller WITHOUT a login
# browse read-only (packages, stats, downloads, health); every mutation still needs a
# session. Off by default (enabling auth locks the console down fully).
# UI_ANON_READ=1

# Shuttle staging dir (constant). Exports are written to <dir>/out and imports
# are read from <dir>/in; you copy out/ onto removable media and drop it into in/
# on the other machine. Defaults to ./shuttle inside the repo (mounted + writable
# by you). Must be writable by PKGCACHE_UID. Override to relocate it:
# PKGCACHE_SHUTTLE=/home/youruser/pkgcache-shuttle
